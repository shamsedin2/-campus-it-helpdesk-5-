{
  "name": "campus-it-helpdesk-api",
  "version": "1.0.0",
  "description": "Express + PostgreSQL API for the Campus IT Help Desk",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/initDb.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "loadtest": "node scripts/loadtest.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/",
      "/scripts/"
    ]
  }
}
