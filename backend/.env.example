# Copy this file to .env and fill it in. Never commit .env.
PORT=4000
# Local:  postgres://postgres:YOUR_PASSWORD@localhost:5432/helpdesk
# Hosted: paste the connection string from Render or Neon
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helpdesk
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Where the frontend runs (comma-separated if more than one)
CORS_ORIGIN=http://localhost:5173
